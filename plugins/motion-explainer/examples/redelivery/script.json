        { "do": "say", "who": "home", "text": "不在票を見て、夜7時に受け取る予約を入れたよ。", "face": "explain" },
        { "do": "swap", "target": "phone", "state": "booked", "fx": { "burst": 44, "word": "pon", "dy": -90 } }
      ]
    },
    {
      "chapter": "再配達",
      "cast": ["driver"],
      "layout": [["truck"], ["house"]],

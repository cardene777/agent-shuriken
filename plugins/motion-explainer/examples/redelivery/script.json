        { "do": "say", "who": "driver", "text": "予約の時間に、もう一度運ぶね。", "face": "explain" }
      ]
    },
    {
      "chapter": "届く",
      "cast": ["driver", { "id": "home", "side": "right" }],
      "layout": [["house"], ["parcel"]],
      "beats": [
        { "do": "swap", "target": "parcel", "state": "delivered", "fx": { "burst": 50, "word": "zuza", "dy": -90 } },
        { "do": "say", "who": "home", "text": "今度はちゃんと受け取れたよ。", "face": "cheer", "act": "hop" }
      ]
    }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diagram-explainer content",
  "description": "Input of scripts/render.py: one explainer document made of pages, sections, and blocks.",
  "type": "object",
  "required": ["title", "lead", "tabs"],
  "properties": {
    "lang": {"enum": ["en", "ja"], "default": "en", "description": "Document language. Sets <html lang>, the interface text, and the language-specific checks"},
    "title": {"type": "string", "description": "Document title"},
    "lead": {"type": "string", "description": "One sentence under the title that says what the subject does"},
    "date": {"type": "string", "description": "Date shown in the header or above the contents list. Defaults to the build date"},
    "tabs": {
      "type": "array",
      "minItems": 1,
      "description": "One page per topic. With 2 or more, tabs in the header switch pages",
      "items": {
        "type": "object",
        "required": ["id", "label", "sections"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "description": "Page key, also used as the section id prefix"},
          "label": {"type": "string", "description": "Tab name in the header"},
          "title": {"type": "string", "description": "Heading at the top of the page. Defaults to label"},
          "lead": {"type": "string", "description": "Sentence under the page heading. The first page falls back to the document lead"},
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "blocks"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "description": "Section id, written <page>-s<n>"},
                "title": {"type": "string"},
                "nofigure": {"type": "string", "description": "Why this section has no figure. check.py fails a section with neither a figure nor a reason"},
                "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["paragraph", "heading", "list", "chart", "keys", "cards", "note", "compare", "html", "table", "code", "details"]}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "paragraph"}}},
          "then": {"properties": {"text": {"type": "string"}}}
        },
        {
          "if": {"properties": {"type": {"const": "heading"}}},
          "then": {"required": ["text"], "properties": {"text": {"type": "string", "description": "Sub-heading inside the section"}}}
        },
        {
          "if": {"properties": {"type": {"const": "list"}}},
          "then": {"required": ["items"], "properties": {"items": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
        },
        {
          "if": {"properties": {"type": {"const": "chart"}}},
          "then": {
            "required": ["id", "kind", "caption", "spec"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
              "kind": {"enum": ["timeband", "capbar", "bars", "period"]},
              "caption": {"type": "string", "description": "Caption starting with the figure number, for example Figure 1"},
              "spec": {"type": "object", "description": "What to draw. assets/charts.js reads the fields for each kind; see references/chart-shape.md"},
              "views": {
                "type": "array",
                "description": "Buttons above a timeband chart. The chosen lanes stay at full strength",
                "items": {
                  "type": "object",
                  "required": ["label"],
                  "properties": {
                    "label": {"type": "string"},
                    "lanes": {"type": "array", "items": {"type": "string"}, "description": "Lane keys to keep; empty keeps every lane"},
                    "say": {"type": "string", "description": "Sentence shown above the chart for this view"}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "keys"}}},
          "then": {
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array", "minItems": 2,
                "description": "Key facts: a number or term to remember (term) and a short explanation (text)",
                "items": {"type": "object", "required": ["term", "text"],
                          "properties": {"term": {"type": "string"}, "text": {"type": "string"}}}
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "cards"}}},
          "then": {
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array", "minItems": 2,
                "description": "Cards side by side for parallel things. Each needs title and either text or list",
                "items": {"type": "object", "required": ["title"],
                          "properties": {"label": {"type": "string", "description": "Small tag above the title"},
                                         "title": {"type": "string"},
                                         "text": {"type": "string"},
                                         "list": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                                         "tone": {"enum": ["accent", "good", "warn", "info"], "default": "accent"}}}
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "note"}}},
          "then": {
            "required": ["text"],
            "properties": {"title": {"type": "string"}, "text": {"type": "string"},
                           "tone": {"enum": ["accent", "good", "warn", "info"], "default": "info",
                                    "description": "warn for cautions, info for side notes"}}
          }
        },
        {
          "if": {"properties": {"type": {"const": "compare"}}},
          "then": {
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array", "minItems": 2, "maxItems": 2,
                "description": "Two values side by side: before on the left, after on the right (emphasized)",
                "items": {"type": "object", "required": ["label", "value"],
                          "properties": {"label": {"type": "string"}, "value": {"type": "string", "description": "The large value"},
                                         "text": {"type": "string"}}}
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "html"}}},
          "then": {
            "required": ["id", "html"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
              "html": {"type": "string", "description": "HTML for a shape the other blocks do not cover. No script, style, link, iframe, object, embed, meta, base, frame, on* attributes, or javascript: URLs"},
              "css": {"type": "string", "description": "CSS that applies only inside this block (nested under the block id). No @import or tags"},
              "caption": {"type": "string", "description": "With a caption the block becomes a figure and counts as the section's figure"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "table"}}},
          "then": {
            "required": ["columns", "rows"],
            "properties": {
              "columns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}, "description": "Each row has as many cells as columns"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "code"}}},
          "then": {"properties": {"text": {"type": "string"}, "language": {"type": "string", "description": "Added as class language-<name>"}}}
        },
        {
          "if": {"properties": {"type": {"const": "details"}}},
          "then": {
            "required": ["summary"],
            "properties": {
              "summary": {"type": "string", "description": "Label of the collapsed block"},
              "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}
            }
          }
        }
      ]
    }
  }
}
